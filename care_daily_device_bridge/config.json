{
  "name": "Care Daily Device Bridge",
  "version": "0.3.3",
  "slug": "care_daily_device_bridge",
  "image": "ghcr.io/caredailyai/care-daily-bridge",
  "description": "Bridge between Home Assistant and Care Daily Cloud for real-time device monitoring",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "application",
  "boot": "auto",
  "ports": {
    "5000/tcp": 5000
  },
  "ports_description": {
    "5000/tcp": "Web UI port"
  },
  "options": {
    "db_path": "/data/care_daily_bridge.db"
  },
  "schema": {
    "db_path": "str?"
  },
  "map": [
    "config:rw",
    "share:rw"
  ],
  "homeassistant_api": true,
  "hassio_api": true,
  "hassio_role": "default",
  "auth_api": true,
  "ingress": true,
  "ingress_port": 5000,
  "panel_icon": "mdi:bridge",
  "panel_title": "Care Daily Bridge",
  "webui": "[PROTO:ssl]://[HOST]:[PORT:5000]"
}
